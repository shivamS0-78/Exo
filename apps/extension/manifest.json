{
  "manifest_version": 3,
  "name": "Exo — Local Work Assistant",
  "version": "0.1.0",
  "description": "Carry a shared issue into your local repository with explicit control.",
  "permissions": ["sidePanel", "nativeMessaging", "storage"],
  "host_permissions": ["https://github.com/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://github.com/*/*/issues/*", "https://github.com/*/*/pull/*"],
    "js": ["github-context.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Open Exo" },
  "side_panel": { "default_path": "sidepanel.html" }
}
